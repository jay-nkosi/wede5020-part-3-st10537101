// FAQ ACCORDION
document.querySelectorAll(".accordion-trigger").forEach(trigger => {
  trigger.addEventListener("click", () => {
    const item = trigger.closest(".accordion-item");
    const willOpen = !item.classList.contains("open");

    document.querySelectorAll(".accordion-item").forEach(other => {
      other.classList.remove("open");
      other.querySelector(".accordion-trigger").setAttribute("aria-expanded", "false");
      other.querySelector(".accordion-trigger span").textContent = "＋";
    });

    if (willOpen) {
      item.classList.add("open");
      trigger.setAttribute("aria-expanded", "true");
      trigger.querySelector("span").textContent = "−";
    }
  });
});


// GALLERY LIGHTBOX
const lightbox = document.getElementById("lightbox");

function closeLightbox() {
  if (lightbox) lightbox.classList.remove("show");
}

if (lightbox) {
  document.querySelectorAll(".gallery-image").forEach(button => {
    button.addEventListener("click", () => {
      const image = button.querySelector("img");
      document.getElementById("lightboxImage").src = image.src;
      document.getElementById("lightboxImage").alt = image.alt;
      lightbox.classList.add("show");
    });
  });

  document.getElementById("lightboxClose")?.addEventListener("click", closeLightbox);

  lightbox.addEventListener("click", event => {
    if (event.target === lightbox) closeLightbox();
  });
}

document.addEventListener("keydown", event => {
  if (event.key === "Escape") {
    if (modal) modal.classList.remove("show");
    closeLightbox();
  }
});


// FORM VALIDATION FUNCTIONS
function setError(id, message) {
  const element = document.getElementById(id);
  if (element) element.textContent = message;
}

function validEmail(value) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
}

function validPhone(value) {
  return /^[0-9+() -]{9,20}$/.test(value);
}

function showNotice(id, message) {
  const element = document.getElementById(id);

  if (element) {
    element.textContent = message;
    element.classList.add("show");
  }
}

function openEmail(subject, body) {
  const recipient = "sales@jaymonateautosa.co.za";

  window.location.href =
    "mailto:" + recipient +
    "?subject=" + encodeURIComponent(subject) +
    "&body=" + encodeURIComponent(body);
}


// VEHICLE ENQUIRY FORM
const enquiryForm = document.getElementById("enquiryForm");

if (enquiryForm) {
  enquiryForm.addEventListener("submit", event => {
    event.preventDefault();

    [
      "enqNameError",
      "enqEmailError",
      "enqPhoneError",
      "enqAreaError",
      "enqInterestError",
      "enqMessageError"
    ].forEach(id => setError(id, ""));

    const name = document.getElementById("enqName").value.trim();
    const email = document.getElementById("enqEmail").value.trim();
    const phone = document.getElementById("enqPhone").value.trim();
    const area = document.getElementById("enqArea").value.trim();
    const interest = document.getElementById("enqInterest").value;
    const message = document.getElementById("enqMessage").value.trim();

    let valid = true;

    if (name.length < 2) {
      setError("enqNameError", "Please enter your full name.");
      valid = false;
    }

    if (!validEmail(email)) {
      setError("enqEmailError", "Enter a valid email address.");
      valid = false;
    }

    if (!validPhone(phone)) {
      setError("enqPhoneError", "Enter a valid phone number.");
      valid = false;
    }

    if (!area) {
      setError("enqAreaError", "Please enter your area or suburb.");
      valid = false;
    }

    if (!interest) {
      setError("enqInterestError", "Please choose the type of enquiry.");
      valid = false;
    }

    if (message.length < 10 || message.length > 1000) {
      setError("enqMessageError", "Your message must be between 10 and 1,000 characters.");
      valid = false;
    }

    const date = document.getElementById("enqDate").value;

    if (date && date < new Date().toISOString().slice(0, 10)) {
      setError("enqMessageError", "Please choose a future test-drive date.");
      valid = false;
    }

    if (!valid) {
      showNotice("enquiryNotice", "Please correct the highlighted fields and submit the form again.");
      return;
    }

    const details = [
      "Name: " + name,
      "Email: " + email,
      "Phone: " + phone,
      "Area: " + area,
      "Enquiry type: " + interest,
      "Vehicle: " + document.getElementById("enqVehicle").value,
      "Preferred date: " + (date || "Not specified"),
      "Budget: " + (document.getElementById("enqBudget").value || "Not specified"),
      "",
      "Message:",
      message
    ].join("\n");

    showNotice(
      "enquiryNotice",
      "Your details are valid. Your email application should open with the enquiry prepared. Please review and send it."
    );

    openEmail("Vehicle enquiry - " + name, details);
  });
}


// GENERAL CONTACT FORM
const contactForm = document.getElementById("contactForm");

if (contactForm) {
  contactForm.addEventListener("submit", event => {
    event.preventDefault();

    [
      "contactNameError",
      "contactEmailError",
      "contactPhoneError",
      "contactTypeError",
      "contactMessageError"
    ].forEach(id => setError(id, ""));

    const name = document.getElementById("contactName").value.trim();
    const email = document.getElementById("contactEmail").value.trim();
    const phone = document.getElementById("contactPhone").value.trim();
    const type = document.getElementById("contactType").value;
    const message = document.getElementById("contactMessage").value.trim();

    let valid = true;

    if (name.length < 2) {
      setError("contactNameError", "Please enter your full name.");
      valid = false;
    }

    if (!validEmail(email)) {
      setError("contactEmailError", "Enter a valid email address.");
      valid = false;
    }

    if (phone && !validPhone(phone)) {
      setError("contactPhoneError", "Enter a valid phone number.");
      valid = false;
    }

    if (!type) {
      setError("contactTypeError", "Please select a message type.");
      valid = false;
    }

    if (message.length < 10 || message.length > 1200) {
      setError("contactMessageError", "Your message must be between 10 and 1,200 characters.");
      valid = false;
    }

    if (!valid) {
      showNotice("contactNotice", "Please correct the highlighted fields and try again.");
      return;
    }

    const details = [
      "Name: " + name,
      "Email: " + email,
      "Phone: " + (phone || "Not supplied"),
      "Message type: " + type,
      "",
      "Message:",
      message
    ].join("\n");

    showNotice(
      "contactNotice",
      "Your details are valid. Your email application should open with the message prepared. Please review and send it."
    );

    openEmail("Website contact - " + type, details);
  });
}


